<?xml version="1.0" encoding="utf-8"?>
<net.smartlogic.unitconverter.percentage.PercentageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/percentage_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/percentage_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/percentage_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/percentage_mode_of"
                style="@style/PercentageModeButton"
                android:text="@string/percentage_mode_of" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/percentage_mode_increase"
                style="@style/PercentageModeButton"
                android:text="@string/percentage_mode_increase" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/percentage_mode_decrease"
                style="@style/PercentageModeButton"
                android:text="@string/percentage_mode_decrease" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/percentage_mode_what"
                style="@style/PercentageModeButton"
                android:text="@string/percentage_mode_what" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:id="@+id/percentage_first_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/converter_small_spacing"
            android:orientation="vertical">

            <TextView
                android:tag="content_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/percentage_first_label"
                style="@style/ConverterLabel"
                android:labelFor="@id/percentage_first_input"
                android:text="@string/percentage_base_amount" />

            <net.smartlogic.unitconverter.widget.AutoSizeEditText
                android:id="@+id/percentage_first_input"
                style="@style/ConverterValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/percentage_base_amount"
                android:gravity="end|center_vertical"
                android:hint="@string/zero"
                android:maxLength="12"
                android:minHeight="@dimen/converter_row_height"
                android:paddingHorizontal="@dimen/converter_field_content_inset"
                android:tag="converter_amount" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/percentage_second_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/converter_small_spacing"
            android:orientation="vertical">

            <TextView
                android:tag="content_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/percentage_second_label"
                style="@style/ConverterLabel"
                android:labelFor="@id/percentage_second_input"
                android:text="@string/percentage_percent_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/converter_row_height"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/converter_field_content_inset"
                android:tag="converter_amount">

                <net.smartlogic.unitconverter.widget.AutoSizeEditText
                    android:id="@+id/percentage_second_input"
                    style="@style/ConverterValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/percentage_percent_label"
                    android:gravity="end|center_vertical"
                    android:hint="@string/zero"
                    android:maxLength="12" />

                <TextView
                android:tag="content_primary"
                    android:id="@+id/percentage_second_suffix"
                    style="@style/ConverterSelectorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/converter_small_spacing"
                    android:importantForAccessibility="no"
                    android:text="@string/percentage_percent_suffix" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/percentage_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_converter_card"
        android:orientation="vertical"
        android:padding="@dimen/converter_spacing"
        android:tag="theme_outlined_surface">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/percentage_result_caption"
            style="@style/ConverterLabel"
            android:gravity="center"
            android:tag="content_secondary"
            android:text="@string/percentage_result_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/percentage_result_value"
            style="@style/ResultDisplay"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:tag="content_accent"
            android:text="@string/percentage_no_result" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/percentage_result_explain"
            style="@style/ConverterLabel"
            android:layout_marginTop="@dimen/converter_small_spacing"
            android:gravity="center"
            android:tag="content_primary" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/percentage_keypad_host"
        android:name="net.smartlogic.unitconverter.percentage.PercentageKeypadFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</net.smartlogic.unitconverter.percentage.PercentageLayout>
