<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:focusableInTouchMode="true"
    android:padding="@dimen/converter_card_padding">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/converter_picker_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="@font/app_text" android:textSize="@dimen/converter_picker_title_size"
            android:accessibilityHeading="true"/>
        <ImageButton android:id="@+id/converter_picker_close"
            android:layout_width="@dimen/converter_touch_target" android:layout_height="@dimen/converter_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless" android:padding="@dimen/converter_spacing"
            android:src="@drawable/ic_picker_close" android:contentDescription="@string/converter_picker_close"/>
    </LinearLayout>
    <com.google.android.material.textfield.TextInputLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/converter_picker_search_box"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/converter_spacing" android:layout_marginBottom="@dimen/converter_spacing"
        app:startIconDrawable="@drawable/ic_picker_search" app:endIconMode="clear_text"
        app:hintTextAppearance="@style/ConverterPickerHint"
        app:boxCornerRadiusTopStart="@dimen/converter_picker_corner" app:boxCornerRadiusTopEnd="@dimen/converter_picker_corner"
        app:boxCornerRadiusBottomStart="@dimen/converter_picker_corner" app:boxCornerRadiusBottomEnd="@dimen/converter_picker_corner">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/converter_picker_search"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="@dimen/converter_touch_target" android:fontFamily="@font/app_text"
            android:textSize="@dimen/converter_picker_item_size" android:inputType="text"
            android:singleLine="true" android:imeOptions="actionSearch" android:importantForAutofill="no"/>
    </com.google.android.material.textfield.TextInputLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/converter_picker_list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@null" android:clipToPadding="false"/>
        <TextView android:id="@+id/converter_picker_empty"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="@dimen/converter_spacing" android:fontFamily="@font/app_text"
            android:textSize="@dimen/converter_picker_item_size" android:text="@string/converter_picker_empty"
            android:accessibilityLiveRegion="polite" android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>
