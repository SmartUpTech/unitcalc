<?xml version="1.0" ?>
<net.smartlogic.unitconverter.widget.CalculationViewport
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calculate_pane"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <net.smartlogic.unitconverter.widget.CalculationLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/calculation_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/display_values"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/converter_card_margin"
                android:paddingTop="@dimen/converter_spacing"
                android:paddingBottom="@dimen/converter_spacing">
                <net.smartlogic.unitconverter.widget.AutoSizeValueTextView
                    android:id="@+id/expression"
                    android:autoSizeTextType="uniform"
                    android:autoSizePresetSizes="@array/expression_text_sizes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:fontFamily="@font/app_text"
                    android:gravity="center"
                    android:maxLines="1"
                    android:scrollHorizontally="false"
                    android:singleLine="false"
                    android:textColor="@color/semantic_number"
                    android:textSize="@dimen/h2"/>
                <net.smartlogic.unitconverter.widget.AutoSizeValueTextView
                    android:id="@+id/result"
                    style="@style/ResultDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="@dimen/resultDisplaySize"
                    android:autoSizeMinTextSize="@dimen/value_text_min_size"
                    android:autoSizeStepGranularity="@dimen/value_text_size_step"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/zero"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/keypad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/converter_spacing">
            <net.smartlogic.unitconverter.widget.KeypadRowLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/power"
                    style="@style/CalculatorKey.Function"
                    android:text="@string/calculator_power_key"/>
                <Button
                    android:id="@+id/sqrt"
                    style="@style/CalculatorKey.Function"
                    android:text="@string/calculator_square_root_key"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no"/>
                <ImageButton
                    android:id="@+id/backspace"
                    style="@style/CalculatorKey.Icon"
                    android:contentDescription="Backspace"
                    android:src="@drawable/backspace"/>
            </net.smartlogic.unitconverter.widget.KeypadRowLayout>
            <net.smartlogic.unitconverter.widget.KeypadRowLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/parenthesis_open"
                    style="@style/CalculatorKey.Function"
                    android:text="@string/calculator_open_parenthesis_key"/>
                <Button
                    android:id="@+id/parenthesis_close"
                    style="@style/CalculatorKey.Function"
                    android:text="@string/calculator_close_parenthesis_key"/>
                <Button
                    android:id="@+id/percent"
                    style="@style/CalculatorKey.Function"
                    android:text="@string/calculator_percent_key"/>
                <Button
                    android:id="@+id/divide"
                    style="@style/CalculatorKey.SideOperator"
                    android:text="@string/divide"/>
            </net.smartlogic.unitconverter.widget.KeypadRowLayout>
            <net.smartlogic.unitconverter.widget.KeypadRowLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/seven"
                    style="@style/CalculatorKey.Number"
                    android:text="@string/seven"/>
                <Button
                    android:id="@+id/eight"
                    style="@style/CalculatorKey.Number"
                    android:text="@string/eight"/>
                <Button
                    android:id="@+id/nine"
                    style="@style/CalculatorKey.Number"
                    android:text="@string/nine"/>
                <Button
                    android:id="@+id/multiply"
                    style="@style/CalculatorKey.SideOperator"
                    android:text="@string/multiply"/>
            </net.smartlogic.unitconverter.widget.KeypadRowLayout>
            <net.smartlogic.unitconverter.widget.KeypadRowLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/four"
                    style="@style/CalculatorKey.Number"
                    android:text="@string/default_number_decimals"/>
                <Button
                    android:id="@+id/five"
                    style="@style/CalculatorKey.Number"
                    android:text="@string/five"/>
                <Button
                    android:id="@+id/six"
                    style="@style/CalculatorKey.Number"
                    android:text="@string/six"/>
                <Button
                    android:id="@+id/minus"
                    style="@style/CalculatorKey.SideOperator"
                    android:text="@string/calculator_minus_key"/>
            </net.smartlogic.unitconverter.widget.KeypadRowLayout>
            <net.smartlogic.unitconverter.widget.KeypadRowLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/one"
                    style="@style/CalculatorKey.Number"
                    android:text="@string/one"/>
                <Button
                    android:id="@+id/two"
                    style="@style/CalculatorKey.Number"
                    android:text="@string/two"/>
                <Button
                    android:id="@+id/three"
                    style="@style/CalculatorKey.Number"
                    android:text="@string/three"/>
                <Button
                    android:id="@+id/plus"
                    style="@style/CalculatorKey.SideOperator"
                    android:text="@string/plus"/>
            </net.smartlogic.unitconverter.widget.KeypadRowLayout>
            <net.smartlogic.unitconverter.widget.KeypadRowLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/sign_toggle"
                    style="@style/CalculatorKey.Function"
                    android:text="@string/calculator_sign_key"/>
                <Button
                    android:id="@+id/zero"
                    style="@style/CalculatorKey.Number"
                    android:text="@string/zero"/>
                <Button
                    android:id="@+id/dot"
                    style="@style/CalculatorKey.Number"
                    android:text="@string/default_decimal_separator"/>
                <Button
                    android:id="@+id/equal"
                    style="@style/CalculatorKey.Equals"
                    android:text="@string/equal"/>
            </net.smartlogic.unitconverter.widget.KeypadRowLayout>
        </LinearLayout>
    </net.smartlogic.unitconverter.widget.CalculationLayout>
</net.smartlogic.unitconverter.widget.CalculationViewport>
