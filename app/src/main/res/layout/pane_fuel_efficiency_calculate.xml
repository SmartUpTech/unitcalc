<?xml version="1.0" encoding="utf-8"?>
<net.smartlogic.unitconverter.fuel.FuelEfficiencyLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fuel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/fuel_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/fe_distance_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="@dimen/converter_small_spacing">

                <TextView
                    style="@style/BmiFieldLabel"
                    android:labelFor="@id/fe_distance_input"
                    android:text="@string/fuel_trip_distance" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <net.smartlogic.unitconverter.widget.AutoSizeEditText
                        android:id="@+id/fe_distance_input"
                        style="@style/BmiInput"
                        android:contentDescription="@string/fuel_trip_distance" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fe_distance_unit"
                        style="@style/BmiUnitButton"
                        android:layout_width="@dimen/converter_touch_target"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/fuel_pick_distance" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fe_efficiency_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/converter_small_spacing">

                <TextView
                    style="@style/BmiFieldLabel"
                    android:labelFor="@id/fe_efficiency_input"
                    android:text="@string/fuel_efficiency_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <net.smartlogic.unitconverter.widget.AutoSizeEditText
                        android:id="@+id/fe_efficiency_input"
                        style="@style/BmiInput"
                        android:contentDescription="@string/fuel_efficiency_label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fe_efficiency_unit"
                        style="@style/BmiUnitButton"
                        android:layout_width="@dimen/converter_category_min_width"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/fuel_pick_efficiency" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/converter_small_spacing"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="@dimen/converter_small_spacing">

                <TextView
                    style="@style/BmiFieldLabel"
                    android:labelFor="@id/fe_price_input"
                    android:text="@string/fuel_price_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <net.smartlogic.unitconverter.widget.AutoSizeEditText
                        android:id="@+id/fe_price_input"
                        style="@style/BmiInput"
                        android:contentDescription="@string/fuel_price_label" />

                    <TextView
                        android:id="@+id/fe_price_unit"
                        style="@style/BmiCaption"
                        android:layout_width="@dimen/converter_category_min_width"
                        android:gravity="center"
                        android:tag="content_secondary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/converter_small_spacing">

                <TextView
                    style="@style/BmiFieldLabel"
                    android:labelFor="@id/fe_passengers_input"
                    android:text="@string/fuel_passengers" />

                <net.smartlogic.unitconverter.widget.AutoSizeEditText
                    android:id="@+id/fe_passengers_input"
                    style="@style/BmiInput"
                    android:contentDescription="@string/fuel_passengers"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/converter_small_spacing"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/BmiFieldLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/fuel_round_trip" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/fe_round_trip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/fuel_round_trip" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fe_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_converter_card"
        android:orientation="vertical"
        android:padding="@dimen/converter_spacing"
        android:tag="theme_outlined_surface">

        <TextView
            android:id="@+id/fe_trip_cost_label"
            style="@style/BmiCaption"
            android:gravity="center"
            android:text="@string/fuel_trip_cost_label"
            android:tag="content_secondary" />

        <TextView
            android:id="@+id/fe_trip_cost_value"
            style="@style/ResultDisplay"
            android:gravity="center"
            android:tag="content_accent"
            android:text="@string/fuel_no_result" />

        <TextView
            android:id="@+id/fe_fuel_needed"
            style="@style/BmiCaption"
            android:layout_marginTop="@dimen/converter_small_spacing"
            android:gravity="center"
            android:tag="content_secondary" />

        <TextView
            android:id="@+id/fe_cost_per_passenger"
            style="@style/BmiText"
            android:layout_marginTop="@dimen/converter_compact_row_spacing"
            android:gravity="center"
            android:tag="content_primary" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fe_keypad_host"
        android:name="net.smartlogic.unitconverter.fuel.FuelEfficiencyKeypadFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</net.smartlogic.unitconverter.fuel.FuelEfficiencyLayout>
