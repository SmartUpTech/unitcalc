<?xml version="1.0" encoding="utf-8"?>
<net.smartlogic.unitconverter.age.AgeCalculateLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/age_calculate_pane" android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout android:id="@+id/age_inputs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/age_birth_button" style="@style/AgeDateButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/age_birth" />
        <com.google.android.material.button.MaterialButton android:id="@+id/age_asof_button" style="@style/AgeDateButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/converter_small_spacing" android:text="@string/age_as_of" />
        <com.google.android.material.button.MaterialButton android:id="@+id/age_today_button" style="@style/AgeDateButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/converter_small_spacing" android:text="@string/age_today" />
    </LinearLayout>

    <LinearLayout android:id="@+id/age_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView style="@style/AgeCaption" android:text="@string/age_result" />
            <TextView android:id="@+id/age_years" style="@style/AgeValue" android:textSize="@dimen/h1" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/age_remainder" style="@style/AgeText" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView style="@style/AgeCaption" android:text="@string/age_next_birthday" />
            <TextView android:id="@+id/age_birthday_details" style="@style/AgeText" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/age_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView style="@style/AgeCaption" android:text="@string/age_summary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/AgeCaption" android:text="@string/age_years_label" /><TextView android:id="@+id/age_total_years" style="@style/AgeValue" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/AgeCaption" android:text="@string/age_months_label" /><TextView android:id="@+id/age_total_months" style="@style/AgeValue" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/AgeCaption" android:text="@string/age_weeks_label" /><TextView android:id="@+id/age_total_weeks" style="@style/AgeValue" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/AgeCaption" android:text="@string/age_days_label" /><TextView android:id="@+id/age_total_days" style="@style/AgeValue" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/AgeCaption" android:text="@string/age_hours_label" /><TextView android:id="@+id/age_total_hours" style="@style/AgeValue" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/AgeCaption" android:text="@string/age_minutes_label" /><TextView android:id="@+id/age_total_minutes" style="@style/AgeValue" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/age_note" style="@style/AgeCaption" android:text="@string/age_totals_note" />
    </LinearLayout>

    <LinearLayout android:id="@+id/age_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/age_calendar" style="@style/AgeDateButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/age_add_calendar" />
        <com.google.android.material.button.MaterialButton android:id="@+id/age_share" style="@style/AgeDateButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/converter_spacing" android:text="@string/share" />
    </LinearLayout>
</net.smartlogic.unitconverter.age.AgeCalculateLayout>
