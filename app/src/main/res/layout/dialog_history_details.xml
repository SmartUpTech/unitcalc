<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/converter_card_margin" android:paddingVertical="@dimen/converter_spacing">
        <TextView android:id="@+id/tv_history_time" style="@style/ConverterLabel" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView style="@style/ConverterLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/converter_card_margin" android:text="@string/history_expression_label" android:tag="history_secondary" />
        <TextView android:id="@+id/tv_history_expression" style="@style/ConverterSelectorText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/converter_unit_text_size" android:textIsSelectable="true" />
        <TextView style="@style/ConverterLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/converter_card_margin" android:text="@string/history_result_label" android:tag="history_secondary" />
        <TextView android:id="@+id/tv_history_result" style="@style/ConverterSelectorText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/historyResultSize" android:textIsSelectable="true" />
        <TextView android:id="@+id/history_legacy_hint" style="@style/ConverterLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/converter_card_margin" android:text="@string/history_legacy_hint" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
