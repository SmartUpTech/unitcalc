<net.smartlogic.unitconverter.widget.CalculationViewport xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<net.smartlogic.unitconverter.calculator.finance.emi.EmiLayout
    android:id="@+id/emi_layout" android:layout_width="match_parent" android:layout_height="match_parent">
<net.smartlogic.unitconverter.calculator.finance.emi.EmiFieldsLayout
    android:id="@+id/emi_fields" android:layout_width="match_parent" android:layout_height="wrap_content"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
 <TextView android:id="@+id/emi_principal_label" style="@style/EmiText" android:layout_width="0dp" android:layout_weight="1" android:text="@string/emi_loan_amount" android:labelFor="@id/emi_principal" />
 <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><net.smartlogic.unitconverter.widget.AutoSizeEditText android:id="@+id/emi_principal" style="@style/EmiInput" android:layout_width="0dp" android:layout_weight="1" android:hint="@string/emi_no_result" /></LinearLayout></FrameLayout>
 </LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
 <TextView android:id="@+id/emi_rate_label" style="@style/EmiText" android:layout_width="0dp" android:layout_weight="1" android:text="@string/emi_annual_rate" android:labelFor="@id/emi_rate" />
 <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><net.smartlogic.unitconverter.widget.AutoSizeEditText android:id="@+id/emi_rate" style="@style/EmiInput" android:layout_width="0dp" android:layout_weight="1" android:hint="@string/emi_no_result" /></LinearLayout></FrameLayout>
 </LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
 <TextView android:id="@+id/emi_tenure_label" style="@style/EmiText" android:layout_width="0dp" android:layout_weight="1" android:text="@string/emi_tenure" android:labelFor="@id/emi_tenure" />
 <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><net.smartlogic.unitconverter.widget.AutoSizeEditText android:id="@+id/emi_tenure" style="@style/EmiInput" android:layout_width="0dp" android:layout_weight="1" android:hint="@string/emi_no_result" /><com.google.android.material.button.MaterialButton android:id="@+id/emi_units" style="@style/EmiAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/emi_years" /></LinearLayout></FrameLayout>
 </LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
 <TextView android:id="@+id/emi_date_label" style="@style/EmiText" android:layout_width="0dp" android:layout_weight="1" android:text="@string/emi_first_date" android:labelFor="@id/emi_date" />
 <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><com.google.android.material.button.MaterialButton android:id="@+id/emi_date" style="@style/AgeInlineDate" android:layout_width="match_parent" android:layout_height="wrap_content" /></FrameLayout>
 </LinearLayout></net.smartlogic.unitconverter.calculator.finance.emi.EmiFieldsLayout>
<LinearLayout android:id="@+id/emi_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
 <LinearLayout android:id="@+id/emi_result_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
 <TextView android:id="@+id/emi_value_label" style="@style/EmiCaption" android:gravity="center" android:text="@string/emi_monthly" />
 <TextView android:id="@+id/emi_value" style="@style/EmiText" android:textSize="@dimen/emi_result_size" android:gravity="center" android:text="@string/emi_no_result" android:accessibilityLiveRegion="polite" />
 </LinearLayout>
 <TextView android:id="@+id/emi_total_interest" style="@style/EmiText" android:text="@string/emi_no_result" />
 <TextView android:id="@+id/emi_total_payment" style="@style/EmiText" android:text="@string/emi_no_result" />
 <TextView android:id="@+id/emi_message" style="@style/EmiCaption" android:gravity="center" android:text="@string/emi_empty" android:accessibilityLiveRegion="polite" />
</LinearLayout>
<FrameLayout android:id="@+id/emi_keys" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"><include layout="@layout/converter_keypad" /></FrameLayout>
<LinearLayout android:id="@+id/emi_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
 <com.google.android.material.button.MaterialButton android:id="@+id/emi_insights" style="@style/EmiAction" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/emi_insights" />
 <com.google.android.material.button.MaterialButton android:id="@+id/emi_more" style="@style/EmiAction" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/emi_more" />
</LinearLayout>
</net.smartlogic.unitconverter.calculator.finance.emi.EmiLayout></net.smartlogic.unitconverter.widget.CalculationViewport>
