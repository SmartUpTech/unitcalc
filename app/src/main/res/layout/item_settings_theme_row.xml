<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/graphy_spacing_sm"
    android:paddingBottom="@dimen/graphy_spacing_md">

    <TextView
        android:id="@+id/tv_theme_title"
        style="@style/SettingsRowTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/prefs_title_theme" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/theme_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/graphy_spacing_sm" />
</LinearLayout>
