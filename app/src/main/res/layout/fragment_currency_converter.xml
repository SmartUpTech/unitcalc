<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calculator_accent_color"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:context=".fragment.ConverterFragment">

        <TextView
            android:id="@+id/txtRate"
            android:layout_width="wrap_content"
            android:layout_height="80dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="5dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/display_result_text_color" />

        <LinearLayout
            android:id="@+id/ll_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/txtRate"
            android:orientation="vertical"
            android:weightSum="9">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spinnerHeight"
                    android:orientation="horizontal"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp">

                    <EditText
                        android:id="@+id/input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_margin="2dp"
                        android:layout_weight="0.4"
                        android:background="@null"
                        android:cursorVisible="false"
                        android:gravity="center_vertical|end"
                        android:maxLength="8"
                        android:padding="5dp"
                        android:text="@string/zero"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/display_result_text_color"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/h1" />

                    <TextView
                        android:id="@+id/inputSymbol"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.1"
                        android:gravity="center_vertical|start"
                        android:textColor="@color/display_result_text_color"
                        android:textSize="@dimen/h2" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="0.1"
                        android:gravity="center_horizontal"
                        android:text="@string/equal"
                        android:textColor="@color/display_result_text_color"
                        android:textSize="@dimen/h1" />

                    <EditText
                        android:id="@+id/output"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_margin="2dp"
                        android:layout_weight="0.4"
                        android:background="@null"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:gravity="center_vertical|end"
                        android:padding="5dp"
                        android:singleLine="true"
                        android:text="@string/zero"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/display_result_text_color"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/h1" />

                    <TextView
                        android:id="@+id/outputSymbol"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.1"
                        android:gravity="center_vertical|start"
                        android:textColor="@color/display_result_text_color"
                        android:textSize="@dimen/h2" />


                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_weight="1.3"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp">

                    <RelativeLayout
                        android:id="@+id/fromUnit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/display_result_text_color">

                        <ImageView
                            android:id="@+id/fromFlag"
                            android:layout_width="50dp"
                            android:layout_height="28dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/us" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/fromFlag"
                            android:orientation="vertical"
                            android:paddingStart="5dp">

                            <TextView
                                android:id="@+id/fromCurrency"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/display_result_text_color"
                                android:textSize="@dimen/h3" />

                            <TextView
                                android:id="@+id/fromCurrencyISO"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingEnd="10dp"
                                android:textColor="@color/display_result_text_color"
                                android:textSize="@dimen/h3_5" />


                        </LinearLayout>


                    </RelativeLayout>

                    <ImageView
                        android:contentDescription="@string/strContentDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="0.2"
                        android:gravity="center_horizontal"
                        app:tint="@color/display_result_text_color"
                        android:src="@drawable/ic_arrow_forward" />

                    <LinearLayout
                        android:id="@+id/toUnit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:gravity="center">

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_horizontal"
                            android:layout_margin="2dp"

                            android:textColor="@color/display_result_text_color">

                            <ImageView
                                android:id="@+id/toFlag"
                                android:layout_width="50dp"
                                android:layout_height="28dp"
                                android:layout_centerVertical="true"
                                android:src="@drawable/in" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_toEndOf="@+id/toFlag"
                                android:orientation="vertical"
                                android:paddingStart="5dp">

                                <TextView
                                    android:id="@+id/toCurrency"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/display_result_text_color"
                                    android:textSize="@dimen/h3" />

                                <TextView
                                    android:id="@+id/toCurrencyISO"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingEnd="10dp"
                                    android:textColor="@color/display_result_text_color"
                                    android:textSize="@dimen/h3_5" />


                            </LinearLayout>


                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="0.5"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/txtLastUpdateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/txtLastUpdateTime"
                    android:text="Refreshed at "
                    android:textColor="@color/display_result_text_color"
                    android:textSize="@dimen/h4" />

                <TextView
                    android:id="@+id/txtLastUpdateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:textColor="@color/display_result_text_color"
                    android:textSize="@dimen/h4" />

                <TextView
                    android:id="@+id/txtSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtLastUpdateTime"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="@string/url_exchangeratesapi"
                    android:textColor="@color/display_result_text_color"
                    android:textSize="@dimen/h5" />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/share"
                    style="@style/ActionButtons"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@string/share"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:src="@drawable/share"
                    android:stateListAnimator="@null"
                    android:text=""
                    app:tint="@color/colorNewGrey" />

               <!-- <ImageButton
                    android:id="@+id/copy"
                    style="@style/ActionButtons"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Copy"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:src="@drawable/copy"
                    android:stateListAnimator="@null"
                    android:text=""
                    app:tint="@color/colorNewGrey" />-->

                <ImageButton
                    android:id="@+id/refresh"
                    style="@style/ActionButtons"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Refresh"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:src="@drawable/ic_unit_converter"
                    android:stateListAnimator="@null"
                    android:text=""
                    app:tint="@color/colorNewGrey" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="5"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="4">

                <TableLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3">

                    <TableRow
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/seven"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/seven" />

                        <Button
                            android:id="@+id/eight"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/eight" />

                        <Button
                            android:id="@+id/nine"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/nine" />


                    </TableRow>

                    <!--third row-->
                    <TableRow
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/four"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/four" />

                        <Button
                            android:id="@+id/five"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/five" />

                        <Button
                            android:id="@+id/six"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/six" />


                    </TableRow>

                    <TableRow
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/one"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/one" />

                        <Button
                            android:id="@+id/two"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/two" />

                        <Button
                            android:id="@+id/three"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/three" />


                    </TableRow>

                    <!--fifth row-->
                    <TableRow
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/zero"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/zero" />

                        <Button
                            android:id="@+id/double_zero"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/double_zero" />

                        <Button
                            android:id="@+id/dot"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/dot" />


                    </TableRow>
                </TableLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:background="@color/pad_numeric_background_color"
                    android:orientation="vertical"
                    android:weightSum="4">

                    <ImageButton
                        android:id="@+id/reverse"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/pad_button_equal"
                        android:src="@drawable/ic_reverse"
                        app:tint="@color/unit_text_color" />

                    <ImageButton
                        android:id="@+id/backspace"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/pad_numeric_background_color"
                        android:src="@drawable/backspace"
                        app:tint="@color/display_result_text_color" />

                    <ImageButton
                        android:id="@+id/copy"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/pad_numeric_background_color"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/display_result_text_color" />

                    <Button
                        android:id="@+id/ac"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/pad_numeric_background_color"
                        android:textSize="@dimen/buttonTextSize" />

                </LinearLayout>


            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        app:adSize="BANNER"
        app:adUnitId="@string/am_banner_ad_unit" />
</LinearLayout>