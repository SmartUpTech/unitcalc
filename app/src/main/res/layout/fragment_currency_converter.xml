<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">
    <net.smartlogic.unitconverter.widget.CalculationViewport
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">
        <net.smartlogic.unitconverter.widget.CalculationLayout
            android:id="@+id/ll_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/converter_spacing">
            <net.smartlogic.unitconverter.widget.ConverterControlsLayout
                android:id="@+id/calculation_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/converter_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/converter_card_margin"
                    android:layout_marginEnd="@dimen/converter_swap_end_margin"
                    android:paddingVertical="@dimen/converter_spacing">
                    <net.smartlogic.unitconverter.widget.ConverterValueRow
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_0dp"
                        android:id="@+id/converter_source_section"
                        android:tag="calculation_section"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/reverse_container"
                        app:layout_constraintTop_toTopOf="parent"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/converter_row_height">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/converter_spacing"
                            android:baselineAligned="false"
                            android:tag="converter_amount"
                            android:paddingHorizontal="@dimen/converter_field_content_inset"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/inputSymbol"
                                style="@style/ConverterSelectorText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/converter_small_spacing"
                                android:textSize="@dimen/converter_currency_symbol_size"
                                android:singleLine="true"
                                android:includeFontPadding="false"
                                android:importantForAccessibility="no" />
                            <net.smartlogic.unitconverter.widget.AutoSizeEditText
                                android:id="@+id/input"
                                style="@style/ConverterValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/converter_input_amount" android:hint="@string/zero"
                                android:maxLength="12"
                                android:layout_weight="1"
                                android:gravity="right|center_vertical" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_weight="1.25">
                            <TextView
                                style="@style/ConverterLabel"
                                android:id="@+id/converter_from_label"
                                android:visibility="gone"
                                android:layout_width="@dimen/converter_label_width"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/converter_spacing"
                                android:labelFor="@id/fromUnit"
                                android:text="@string/str_from" />
                            <RelativeLayout
                                android:id="@+id/fromUnit"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:minHeight="@dimen/converter_touch_target"
                                android:paddingVertical="@dimen/spacing_0dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:tag="converter_selector"
                                android:paddingHorizontal="@dimen/converter_field_content_inset"
                                android:foreground="?attr/selectableItemBackground">
                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/fromFlag"
                                    android:layout_width="@dimen/converter_flag_width"
                                    android:layout_height="@dimen/converter_flag_height"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerVertical="true"
                                    android:scaleType="centerCrop"
                                    android:importantForAccessibility="no"
                                    app:shapeAppearanceOverlay="@style/RoundedCorners" />
                                <LinearLayout
                                    android:importantForAccessibility="noHideDescendants"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toEndOf="@id/fromFlag"
                                    android:layout_toStartOf="@id/fromChevron"
                                    android:layout_marginHorizontal="@dimen/converter_field_content_inset"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_centerVertical="true">
                                    <net.smartlogic.unitconverter.widget.AutoSizeValueTextView
                                        android:id="@+id/fromCurrencyISO"
                                        style="@style/ConverterSelectorText"
                                        android:layout_width="0dp" android:layout_weight="1"
                                        android:layout_height="wrap_content"
                                        android:singleLine="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="@dimen/value_text_min_size" android:autoSizeMaxTextSize="@dimen/converter_unit_text_size" android:autoSizeStepGranularity="@dimen/value_text_size_step" />
                                    <TextView
                                        style="@style/ConverterLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingHorizontal="@dimen/converter_small_spacing"
                                        android:tag="currency_detail"
                                        android:text="@string/converter_currency_separator" />
                                    <TextView
                                        android:id="@+id/fromCurrency"
                                        style="@style/ConverterSelectorText"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:singleLine="true" />
                                </LinearLayout>
                                <ImageView
                                    android:id="@+id/fromChevron"
                                    android:layout_width="@dimen/converter_chevron_size"
                                    android:layout_height="@dimen/converter_chevron_size"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_chevron_down"
                                    android:importantForAccessibility="no"
                                    android:contentDescription="@null" />
                            </RelativeLayout>
                        </LinearLayout>
                    </net.smartlogic.unitconverter.widget.ConverterValueRow>
                    <include
                        layout="@layout/converter_swap"
                        android:id="@+id/reverse_container"
                        android:layout_width="@dimen/converter_touch_target"
                        android:layout_height="@dimen/converter_touch_target"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="@id/converter_target_section" />
                    <ImageButton
                        android:id="@+id/reverse_destinations"
                        style="@style/ConverterIconButton"
                        android:contentDescription="@string/currency_swap_destinations"
                        android:src="@drawable/ic_reverse"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/converter_target_section"
                        app:layout_constraintBottom_toBottomOf="@id/category_selector" />
                    <net.smartlogic.unitconverter.widget.ConverterValueRow
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_0dp"
                        android:id="@+id/converter_target_section"
                        android:layout_marginTop="@dimen/converter_small_spacing"
                        android:tag="calculation_section"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/reverse_container"
                        app:layout_constraintTop_toBottomOf="@id/converter_source_section"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/converter_row_height">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/converter_spacing"
                            android:baselineAligned="false"
                            android:tag="converter_amount"
                            android:paddingHorizontal="@dimen/converter_field_content_inset"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/outputSymbol"
                                style="@style/ConverterSelectorText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/converter_small_spacing"
                                android:textSize="@dimen/converter_currency_symbol_size"
                                android:singleLine="true"
                                android:includeFontPadding="false"
                                android:importantForAccessibility="no" />
                            <net.smartlogic.unitconverter.widget.AutoSizeEditText
                                android:id="@+id/output"
                                style="@style/ConverterValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/converter_output_amount"
                                android:focusable="false"
                                android:textIsSelectable="false"
                                android:layout_weight="1"
                                android:gravity="right|center_vertical" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_weight="1.25">
                            <TextView
                                style="@style/ConverterLabel"
                                android:id="@+id/converter_to_label"
                                android:visibility="gone"
                                android:layout_width="@dimen/converter_label_width"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/converter_spacing"
                                android:labelFor="@id/toUnit"
                                android:text="@string/str_to" />
                            <RelativeLayout
                                android:id="@+id/toUnit"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:minHeight="@dimen/converter_touch_target"
                                android:paddingVertical="@dimen/spacing_0dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:tag="converter_selector"
                                android:paddingHorizontal="@dimen/converter_field_content_inset"
                                android:foreground="?attr/selectableItemBackground">
                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/toFlag"
                                    android:layout_width="@dimen/converter_flag_width"
                                    android:layout_height="@dimen/converter_flag_height"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerVertical="true"
                                    android:scaleType="centerCrop"
                                    android:importantForAccessibility="no"
                                    app:shapeAppearanceOverlay="@style/RoundedCorners" />
                                <LinearLayout
                                    android:importantForAccessibility="noHideDescendants"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toEndOf="@id/toFlag"
                                    android:layout_toStartOf="@id/toChevron"
                                    android:layout_marginHorizontal="@dimen/converter_field_content_inset"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_centerVertical="true">
                                    <net.smartlogic.unitconverter.widget.AutoSizeValueTextView
                                        android:id="@+id/toCurrencyISO"
                                        style="@style/ConverterSelectorText"
                                        android:layout_width="0dp" android:layout_weight="1"
                                        android:layout_height="wrap_content"
                                        android:singleLine="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="@dimen/value_text_min_size" android:autoSizeMaxTextSize="@dimen/converter_unit_text_size" android:autoSizeStepGranularity="@dimen/value_text_size_step" />
                                    <TextView
                                        style="@style/ConverterLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingHorizontal="@dimen/converter_small_spacing"
                                        android:tag="currency_detail"
                                        android:text="@string/converter_currency_separator" />
                                    <TextView
                                        android:id="@+id/toCurrency"
                                        style="@style/ConverterSelectorText"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:singleLine="true" />
                                </LinearLayout>
                                <ImageView
                                    android:id="@+id/toChevron"
                                    android:layout_width="@dimen/converter_chevron_size"
                                    android:layout_height="@dimen/converter_chevron_size"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_chevron_down"
                                    android:importantForAccessibility="no"
                                    android:contentDescription="@null" />
                            </RelativeLayout>
                        </LinearLayout>
                    </net.smartlogic.unitconverter.widget.ConverterValueRow>
                    <net.smartlogic.unitconverter.widget.ConverterValueRow
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_0dp"
                        android:id="@+id/category_selector"
                        android:layout_marginTop="@dimen/converter_small_spacing"
                        android:tag="calculation_section"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/reverse_container"
                        app:layout_constraintTop_toBottomOf="@id/converter_target_section"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/converter_row_height">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/converter_spacing"
                            android:baselineAligned="false"
                            android:tag="converter_amount"
                            android:paddingHorizontal="@dimen/converter_field_content_inset"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/additionalOutputSymbol"
                                style="@style/ConverterSelectorText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/converter_small_spacing"
                                android:textSize="@dimen/converter_currency_symbol_size"
                                android:singleLine="true"
                                android:includeFontPadding="false"
                                android:importantForAccessibility="no" />
                            <net.smartlogic.unitconverter.widget.AutoSizeEditText
                                android:id="@+id/additionalOutput"
                                style="@style/ConverterValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/converter_output_amount"
                                android:focusable="false"
                                android:textIsSelectable="false"
                                android:layout_weight="1"
                                android:gravity="right|center_vertical" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_weight="1.25">
                            <TextView
                                style="@style/ConverterLabel"
                                android:id="@+id/additional_to_label"
                                android:visibility="gone"
                                android:layout_width="@dimen/converter_label_width"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/converter_spacing"
                                android:labelFor="@id/additionalToUnit"
                                android:text="@string/str_to" />
                            <RelativeLayout
                                android:id="@+id/additionalToUnit"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:minHeight="@dimen/converter_touch_target"
                                android:paddingVertical="@dimen/spacing_0dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:tag="converter_selector"
                                android:paddingHorizontal="@dimen/converter_field_content_inset"
                                android:foreground="?attr/selectableItemBackground">
                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/additionalToFlag"
                                    android:layout_width="@dimen/converter_flag_width"
                                    android:layout_height="@dimen/converter_flag_height"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerVertical="true"
                                    android:scaleType="centerCrop"
                                    android:importantForAccessibility="no"
                                    app:shapeAppearanceOverlay="@style/RoundedCorners" />
                                <LinearLayout
                                    android:importantForAccessibility="noHideDescendants"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toEndOf="@id/additionalToFlag"
                                    android:layout_toStartOf="@id/additionalToChevron"
                                    android:layout_marginHorizontal="@dimen/converter_field_content_inset"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_centerVertical="true">
                                    <net.smartlogic.unitconverter.widget.AutoSizeValueTextView
                                        android:id="@+id/additionalToCurrencyISO"
                                        style="@style/ConverterSelectorText"
                                        android:layout_width="0dp" android:layout_weight="1"
                                        android:layout_height="wrap_content"
                                        android:singleLine="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="@dimen/value_text_min_size" android:autoSizeMaxTextSize="@dimen/converter_unit_text_size" android:autoSizeStepGranularity="@dimen/value_text_size_step" />
                                    <TextView
                                        style="@style/ConverterLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:paddingHorizontal="@dimen/converter_small_spacing"
                                        android:tag="currency_detail"
                                        android:text="@string/converter_currency_separator" />
                                    <TextView
                                        android:id="@+id/additionalToCurrency"
                                        style="@style/ConverterSelectorText"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:singleLine="true" />
                                </LinearLayout>
                                <ImageView
                                    android:id="@+id/additionalToChevron"
                                    android:layout_width="@dimen/converter_chevron_size"
                                    android:layout_height="@dimen/converter_chevron_size"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ic_chevron_down"
                                    android:importantForAccessibility="no"
                                    android:contentDescription="@null" />
                            </RelativeLayout>
                        </LinearLayout>
                    </net.smartlogic.unitconverter.widget.ConverterValueRow>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/converter_metadata_height"
                    android:layout_marginHorizontal="@dimen/converter_card_margin"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/txtRate"
                        style="@style/ConverterLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/converter_unit_text_size" />
                    <TextView
                        android:id="@+id/txtLastUpdateTime"
                        style="@style/ConverterLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:layout_marginStart="@dimen/converter_spacing"
                        android:gravity="end|center_vertical" />
                    <ImageButton
                        android:id="@+id/refresh"
                        style="@style/ConverterIconButton"
                        android:padding="@dimen/converter_refresh_icon_padding"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/converter_refresh_rates"
                        android:src="@drawable/ic_unit_converter" />
                </LinearLayout>
            </net.smartlogic.unitconverter.widget.ConverterControlsLayout>
            <include
                layout="@layout/converter_keypad"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:id="@+id/keypad" />
        </net.smartlogic.unitconverter.widget.CalculationLayout>
    </net.smartlogic.unitconverter.widget.CalculationViewport>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
