<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    tools:context=".fragment.CurrencyConverterFragment">

    <TextView
        android:id="@+id/txtRate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/app_text"
        android:padding="8dp"
        android:textColor="@color/screen_expression_text"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/ll_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/txtRate"
        android:orientation="vertical"
        android:weightSum="9">

        <LinearLayout
            android:id="@+id/converter_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/converter_card_margin"
            android:layout_weight="4"
            android:background="@drawable/bg_converter_card"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/converter_card_padding"
                android:paddingTop="@dimen/converter_card_padding"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/app_text"
                    android:text="@string/str_from"
                    android:textColor="@color/screen_expression_text"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/app_text"
                        android:gravity="center_vertical|start"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:maxLength="12"
                        android:paddingEnd="8dp"
                        android:text="@string/zero"
                        android:textColor="@color/screen_result_text"
                        android:textSize="@dimen/converter_value_text_size"
                        android:textStyle="bold"
                        tools:ignore="LabelFor" />

                    <RelativeLayout
                        android:id="@+id/fromUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minWidth="120dp"
                        android:paddingVertical="4dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/fromFlag"
                            android:layout_width="40dp"
                            android:layout_height="28dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:scaleType="centerCrop"
                            android:src="@drawable/us"
                            app:shapeAppearanceOverlay="@style/RoundedCorners" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="8dp"
                            android:layout_toStartOf="@id/fromChevron"
                            android:layout_toEndOf="@id/fromFlag"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/fromCurrency"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/app_text"
                                android:maxLines="1"
                                android:textColor="@color/screen_result_text"
                                android:textSize="@dimen/converter_unit_text_size" />

                            <TextView
                                android:id="@+id/fromCurrencyISO"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/app_text"
                                android:textColor="@color/screen_expression_text"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/fromChevron"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_down" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/reverse_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/converter_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="@dimen/converter_card_padding"
                    android:background="@color/colorNewGrey" />

                <ImageButton
                    android:id="@+id/reverse"
                    style="@style/ImageButtonStyle.Swap"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/str_swap_units"
                    android:src="@drawable/ic_reverse"
                    app:tint="@color/accent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/converter_card_padding"
                android:paddingTop="8dp"
                android:paddingBottom="@dimen/converter_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/app_text"
                    android:text="@string/str_to"
                    android:textColor="@color/screen_expression_text"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/output"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:focusable="false"
                        android:fontFamily="@font/app_text"
                        android:gravity="center_vertical|start"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:paddingEnd="8dp"
                        android:text="@string/zero"
                        android:textColor="@color/screen_result_text"
                        android:textSize="@dimen/converter_value_text_size"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:id="@+id/toUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minWidth="120dp"
                        android:paddingVertical="4dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/toFlag"
                            android:layout_width="40dp"
                            android:layout_height="28dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:scaleType="centerCrop"
                            android:src="@drawable/in"
                            app:shapeAppearanceOverlay="@style/RoundedCorners" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="8dp"
                            android:layout_toStartOf="@id/toChevron"
                            android:layout_toEndOf="@id/toFlag"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/toCurrency"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/app_text"
                                android:maxLines="1"
                                android:textColor="@color/screen_result_text"
                                android:textSize="@dimen/converter_unit_text_size" />

                            <TextView
                                android:id="@+id/toCurrencyISO"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/app_text"
                                android:textColor="@color/screen_expression_text"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/toChevron"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_down" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/inputSymbol"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/outputSymbol"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/txtLastUpdateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/app_text"
                android:textColor="@color/screen_expression_text"
                android:textSize="@dimen/h5" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <ImageButton
                android:id="@+id/share"
                style="@style/ActionButtons"
                android:contentDescription="Share"
                android:src="@drawable/share"
                app:tint="@color/screen_expression_text" />

            <ImageButton
                android:id="@+id/refresh"
                style="@style/ActionButtons"
                android:contentDescription="Refresh"
                android:src="@drawable/ic_unit_converter"
                app:tint="@color/screen_expression_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4.5"
            android:orientation="horizontal"
            android:padding="8dp"
            android:weightSum="4">

            <TableLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:stretchColumns="*">

                <TableRow android:layout_weight="1">
                    <Button
                        android:id="@+id/seven"
                        style="@style/ButtonStyle.Number"
                        android:text="@string/seven" />
                    <Button
                        android:id="@+id/eight"
                        style="@style/ButtonStyle.Number"
                        android:text="@string/eight" />
                    <Button
                        android:id="@+id/nine"
                        style="@style/ButtonStyle.Number"
                        android:text="@string/nine" />
                </TableRow>

                <TableRow android:layout_weight="1">
                    <Button
                        android:id="@+id/four"
                        style="@style/ButtonStyle.Number"
                        android:text="@string/four" />
                    <Button
                        android:id="@+id/five"
                        style="@style/ButtonStyle.Number"
                        android:text="@string/five" />
                    <Button
                        android:id="@+id/six"
                        style="@style/ButtonStyle.Number"
                        android:text="@string/six" />
                </TableRow>

                <TableRow android:layout_weight="1">
                    <Button
                        android:id="@+id/one"
                        style="@style/ButtonStyle.Number"
                        android:text="@string/one" />
                    <Button
                        android:id="@+id/two"
                        style="@style/ButtonStyle.Number"
                        android:text="@string/two" />
                    <Button
                        android:id="@+id/three"
                        style="@style/ButtonStyle.Number"
                        android:text="@string/three" />
                </TableRow>

                <TableRow android:layout_weight="1">
                    <Button
                        android:id="@+id/zero"
                        style="@style/ButtonStyle.Number"
                        android:text="@string/zero" />
                    <Button
                        android:id="@+id/double_zero"
                        style="@style/ButtonStyle.Number"
                        android:text="@string/double_zero" />
                    <Button
                        android:id="@+id/dot"
                        style="@style/ButtonStyle.Number"
                        android:text="@string/dot" />
                </TableRow>
            </TableLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:weightSum="4">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/backspace"
                    style="@style/ImageButtonStyle.Backspace"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Backspace"
                    android:src="@drawable/backspace" />

                <ImageButton
                    android:id="@+id/copy"
                    style="@style/ImageButtonStyle.Action"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="Copy"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/key_action_text" />

                <Button
                    android:id="@+id/ac"
                    style="@style/ButtonStyle.Action"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="AC" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
