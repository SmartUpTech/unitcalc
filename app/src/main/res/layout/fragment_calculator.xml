<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".fragment.CalculatorFragment">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/workspace_tabs"
            style="@style/WorkspaceTabLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/calculate_pane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/display_values"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/expression"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/oswald"
                        android:gravity="end"
                        android:maxLines="2"
                        android:textColor="@color/screen_expression_text"
                        android:textSize="@dimen/h2" />

                    <TextView
                        android:id="@+id/result"
                        style="@style/ResultDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeMaxTextSize="@dimen/resultDisplaySize"
                        android:autoSizeMinTextSize="28sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="0" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/keypad"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/clear"
                            style="@style/ButtonStyle.Action"
                            android:text="@string/clear" />

                        <ImageButton
                            android:id="@+id/backspace"
                            style="@style/ImageButtonStyle.Backspace"
                            android:contentDescription="Backspace"
                            android:src="@drawable/backspace" />

                        <ImageButton
                            android:id="@+id/copy"
                            style="@style/ImageButtonStyle.Action"
                            android:contentDescription="Copy"
                            android:src="@drawable/ic_copy"
                            app:tint="@color/key_action_text" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/advanced_row"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/parenthesis_open"
                            style="@style/ButtonStyle.Operator"
                            android:text="(" />

                        <Button
                            android:id="@+id/parenthesis_close"
                            style="@style/ButtonStyle.Operator"
                            android:text=")" />

                        <Button
                            android:id="@+id/power"
                            style="@style/ButtonStyle.Operator"
                            android:text="^" />

                        <Button
                            android:id="@+id/sqrt"
                            style="@style/ButtonStyle.Operator"
                            android:text="√" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="4.5"
                        android:orientation="horizontal">

                        <TableLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="3"
                            android:stretchColumns="*">

                            <TableRow android:layout_weight="1">
                                <Button style="@style/ButtonStyle.Number" android:id="@+id/seven" android:text="7" />
                                <Button style="@style/ButtonStyle.Number" android:id="@+id/eight" android:text="8" />
                                <Button style="@style/ButtonStyle.Number" android:id="@+id/nine" android:text="9" />
                            </TableRow>
                            <TableRow android:layout_weight="1">
                                <Button style="@style/ButtonStyle.Number" android:id="@+id/four" android:text="4" />
                                <Button style="@style/ButtonStyle.Number" android:id="@+id/five" android:text="5" />
                                <Button style="@style/ButtonStyle.Number" android:id="@+id/six" android:text="6" />
                            </TableRow>
                            <TableRow android:layout_weight="1">
                                <Button style="@style/ButtonStyle.Number" android:id="@+id/one" android:text="1" />
                                <Button style="@style/ButtonStyle.Number" android:id="@+id/two" android:text="2" />
                                <Button style="@style/ButtonStyle.Number" android:id="@+id/three" android:text="3" />
                            </TableRow>
                            <TableRow android:layout_weight="1">
                                <Button style="@style/ButtonStyle.Number" android:id="@+id/zero" android:text="0" />
                                <Button style="@style/ButtonStyle.Number" android:id="@+id/dot" android:text="." />
                                <Button style="@style/ButtonStyle.Number" android:id="@+id/percent" android:text="%" />
                            </TableRow>
                        </TableLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <Button android:id="@+id/divide" style="@style/ButtonStyle.Operator" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="÷" />
                            <Button android:id="@+id/multiply" style="@style/ButtonStyle.Operator" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="×" />
                            <Button android:id="@+id/minus" style="@style/ButtonStyle.Operator" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="-" />
                            <Button android:id="@+id/plus" style="@style/ButtonStyle.Operator" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="+" />
                            <Button android:id="@+id/equal" style="@style/ButtonStyle.Equals" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="=" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/graphy_pane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/graphy_context"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/oswald"
                    android:textColor="@color/screen_expression_text"
                    android:textSize="16sp" />

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/graphy_panel"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/graphy_empty"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/graphy_empty"
                    android:textColor="@color/screen_expression_text"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/history_pane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_history"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="8dp" />

                <TextView
                    android:id="@+id/tv_empty_history"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/no_history"
                    android:textColor="@color/screen_expression_text"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
