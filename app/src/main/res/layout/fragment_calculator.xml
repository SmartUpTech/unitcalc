<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".fragment.CalculatorFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/keypad_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.44" />

            <!-- Display + Graphy overlay. Keypad height never changes. -->
            <RelativeLayout
                android:id="@+id/display_layout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/screen_background"
                android:padding="16dp"
                app:layout_constraintBottom_toTopOf="@id/keypad_guideline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageButton
                    android:id="@+id/btn_history"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="History"
                    android:src="@drawable/ic_history"
                    app:tint="@color/screen_expression_text" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_graphy"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="4dp"
                    android:text="@string/graphy"
                    android:textColor="@color/graphy_on_primary"
                    android:visibility="gone"
                    app:chipBackgroundColor="@color/graphy_primary"
                    app:chipStrokeWidth="0dp" />

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/graphy_panel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@id/display_values"
                    android:layout_below="@id/btn_history"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/display_values"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:gravity="bottom"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/expression"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="2"
                        android:textColor="@color/screen_expression_text"
                        android:textSize="@dimen/h2" />

                    <TextView
                        android:id="@+id/result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="start"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="0"
                        android:textColor="@color/screen_result_text"
                        android:textSize="@dimen/h1" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Pinned keypad: Graphy visibility cannot change this region. -->
            <LinearLayout
                android:id="@+id/keypad"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/keypad_background"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/keypad_guideline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:weightSum="3">

                    <Button
                        android:id="@+id/clear"
                        style="@style/ButtonStyle.Action"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/clear" />

                    <ImageButton
                        android:id="@+id/backspace"
                        style="@style/ImageButtonStyle.Action"
                        android:contentDescription="Backspace"
                        android:src="@drawable/backspace"
                        app:tint="@color/key_action_text" />

                    <ImageButton
                        android:id="@+id/copy"
                        style="@style/ImageButtonStyle.Action"
                        android:contentDescription="Copy"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/key_action_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/advanced_row"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:weightSum="4">

                    <Button
                        android:id="@+id/parenthesis_open"
                        style="@style/ButtonStyle.Operator"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="(" />

                    <Button
                        android:id="@+id/parenthesis_close"
                        style="@style/ButtonStyle.Operator"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text=")" />

                    <Button
                        android:id="@+id/power"
                        style="@style/ButtonStyle.Operator"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="^" />

                    <Button
                        android:id="@+id/sqrt"
                        style="@style/ButtonStyle.Operator"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="√" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="4.5"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:weightSum="4">

                    <TableLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:stretchColumns="*">

                        <TableRow android:layout_weight="1">
                            <Button
                                android:id="@+id/seven"
                                style="@style/ButtonStyle.Number"
                                android:text="7" />
                            <Button
                                android:id="@+id/eight"
                                style="@style/ButtonStyle.Number"
                                android:text="8" />
                            <Button
                                android:id="@+id/nine"
                                style="@style/ButtonStyle.Number"
                                android:text="9" />
                        </TableRow>

                        <TableRow android:layout_weight="1">
                            <Button
                                android:id="@+id/four"
                                style="@style/ButtonStyle.Number"
                                android:text="4" />
                            <Button
                                android:id="@+id/five"
                                style="@style/ButtonStyle.Number"
                                android:text="5" />
                            <Button
                                android:id="@+id/six"
                                style="@style/ButtonStyle.Number"
                                android:text="6" />
                        </TableRow>

                        <TableRow android:layout_weight="1">
                            <Button
                                android:id="@+id/one"
                                style="@style/ButtonStyle.Number"
                                android:text="1" />
                            <Button
                                android:id="@+id/two"
                                style="@style/ButtonStyle.Number"
                                android:text="2" />
                            <Button
                                android:id="@+id/three"
                                style="@style/ButtonStyle.Number"
                                android:text="3" />
                        </TableRow>

                        <TableRow android:layout_weight="1">
                            <Button
                                android:id="@+id/zero"
                                style="@style/ButtonStyle.Number"
                                android:text="0" />
                            <Button
                                android:id="@+id/dot"
                                style="@style/ButtonStyle.Number"
                                android:text="." />
                            <Button
                                android:id="@+id/percent"
                                style="@style/ButtonStyle.Number"
                                android:text="%" />
                        </TableRow>
                    </TableLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:weightSum="5">

                        <Button
                            android:id="@+id/divide"
                            style="@style/ButtonStyle.Operator"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:text="÷" />

                        <Button
                            android:id="@+id/multiply"
                            style="@style/ButtonStyle.Operator"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:text="×" />

                        <Button
                            android:id="@+id/minus"
                            style="@style/ButtonStyle.Operator"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:text="-" />

                        <Button
                            android:id="@+id/plus"
                            style="@style/ButtonStyle.Operator"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:text="+" />

                        <Button
                            android:id="@+id/equal"
                            style="@style/ButtonStyle.Equals"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:text="=" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- History Overlay -->
        <LinearLayout
            android:id="@+id/history_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/screen_background"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                android:paddingHorizontal="16dp">

                <ImageButton
                    android:id="@+id/btn_close_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close History"
                    android:rotation="180"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/screen_expression_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/history"
                    android:textColor="@color/screen_expression_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_clear_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear History"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/screen_expression_text" />
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_history"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp" />

            <TextView
                android:id="@+id/tv_empty_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/no_history"
                android:textColor="@color/screen_expression_text"
                android:visibility="gone" />
        </LinearLayout>

    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
