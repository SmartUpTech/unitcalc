<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/spacing_12dp">

    <TextView
        android:id="@+id/timer_widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/app_text"
        android:text="@string/timer"
        android:textColor="@color/screen_result_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/timer_widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/converter_small_spacing"
        android:fontFamily="@font/app_text"
        android:text="@string/timer_preview_time"
        android:textColor="@color/accent"
        android:textSize="24sp"
        android:textStyle="bold" />

</LinearLayout>
