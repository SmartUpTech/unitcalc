<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl"
    android:background="@color/calculator_accent_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".fragment.ConverterFragment">

        <net.smartlogic.unitconverter.helper.HorizontalListView
            android:id="@+id/horizontal_list"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_alignParentTop="true"
            android:layout_marginTop="5dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/horizontal_list"
            android:orientation="vertical"
            android:weightSum="9">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_weight="2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingTop="2dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="2dp"
                    android:text="@string/str_from"
                    android:textColor="@color/display_result_text_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spinnerHeight"
                    android:orientation="horizontal"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp">

                    <EditText
                        android:id="@+id/input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:cursorVisible="true"
                        android:gravity="center_vertical|end"
                        android:maxLength="12"
                        android:padding="5dp"
                        android:textAlignment="textEnd"
                        android:textColor="@color/display_result_text_color"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/h2"
                        android:importantForAutofill="no" />

                    <Spinner
                        android:id="@+id/fromUnit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/colorNewGrey"
                        android:textColor="@color/display_result_text_color" />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_weight="2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingTop="2dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="2dp"
                    android:text="@string/str_to"
                    android:textColor="@color/display_result_text_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spinnerHeight"
                    android:orientation="horizontal"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp">


                    <EditText
                        android:id="@+id/output"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:gravity="center_vertical|end"
                        android:inputType="textMultiLine"
                        android:padding="5dp"
                        android:singleLine="false"
                        android:textAlignment="textEnd"
                        android:textColor="@color/display_result_text_color"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/h2"
                        android:backgroundTint="@color/colorNewGrey"
                        android:importantForAutofill="no" />

                    <Spinner
                        android:id="@+id/toUnit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/colorNewGrey"
                        android:textColor="@color/display_result_text_color" />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="5"
                android:orientation="horizontal"
                android:weightSum="4"
                android:baselineAligned="false">

                <TableLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3">

                    <TableRow
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/seven"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/seven" />

                        <Button
                            android:id="@+id/eight"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/eight" />

                        <Button
                            android:id="@+id/nine"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/nine" />


                    </TableRow>

                    <!--third row-->
                    <TableRow
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/four"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/four" />

                        <Button
                            android:id="@+id/five"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/five" />

                        <Button
                            android:id="@+id/six"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/six" />

                    </TableRow>

                    <TableRow
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/one"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/one" />

                        <Button
                            android:id="@+id/two"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/two" />

                        <Button
                            android:id="@+id/three"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/three" />


                    </TableRow>

                    <!--fifth row-->
                    <TableRow
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <Button
                            android:id="@+id/zero"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/zero" />

                        <Button
                            android:id="@+id/double_zero"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/double_zero" />

                        <Button
                            android:id="@+id/dot"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/dot" />


                    </TableRow>
                </TableLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:weightSum="4">

                    <ImageButton
                        android:id="@+id/reverse"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/pad_button_equal"
                        android:src="@drawable/ic_reverse"
                        app:tint="@color/unit_text_color" />

                    <ImageButton
                        android:id="@+id/backspace"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/pad_numeric_background_color"
                        android:src="@drawable/backspace"
                        app:tint="@color/display_result_text_color" />

                    <ImageButton
                        android:id="@+id/copy"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/pad_numeric_background_color"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/display_result_text_color" />

                    <Button
                        android:id="@+id/minus"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@color/pad_numeric_background_color"
                        style="@style/ButtonStyle.Number"
                        android:text="@string/minus" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:visibility="gone"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <TextView
                android:text="@string/description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="@string/keywords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:visibility="gone"
            android:background="@color/pad_numeric_background_color"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:weightSum="10">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_gravity="center_vertical"
                android:layout_weight="6"
                android:contentDescription="@string/company"
                android:scaleType="fitEnd"
                android:src="@drawable/image_smart"
                app:tint="@color/colorNewGrey" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_gravity="center_vertical"
                android:layout_weight="4"
                android:contentDescription="@string/company"
                android:scaleType="fitStart"
                android:src="@drawable/image_up"
                app:tint="@color/colorNewGrey" />

        </LinearLayout>

    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>