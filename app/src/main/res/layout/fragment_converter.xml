<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/workspace_tabs"
        style="@style/WorkspaceTabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <LinearLayout
        android:id="@+id/convert_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/converter_tabs"
            style="@style/WorkspaceTabLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:tabIndicatorHeight="1dp"
            app:tabTextAppearance="@style/WorkspaceTabText" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/converter_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/graphy_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/graphy_empty"
        android:textColor="@color/screen_expression_text"
        android:visibility="gone" />

    <TextView
        android:id="@+id/history_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/no_conversion_history"
        android:textColor="@color/screen_expression_text"
        android:visibility="gone" />

</LinearLayout>
