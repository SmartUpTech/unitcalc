<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Shared workspace chrome for calculator/converter screens and future calculators.
      Use inside a vertical LinearLayout via <include layout="@layout/workspace_tabs_pager" />.
    -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/workspace_tabs"
        style="@style/WorkspaceTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/workspace_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</merge>
