<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/convert_pane"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/converter_mode_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/converter_card_margin"
        android:layout_marginTop="@dimen/converter_mode_margin_top"
        android:layout_marginBottom="@dimen/converter_mode_margin_bottom"
        app:selectionRequired="true"
        app:singleSelection="true"
        app:chipSpacingHorizontal="@dimen/converter_spacing"
        app:singleLine="true">
        <com.google.android.material.chip.Chip
            android:id="@+id/btn_unit_mode"
            style="@style/ConverterModeChip"
            android:text="@string/unit_converter" />
        <com.google.android.material.chip.Chip
            android:id="@+id/btn_currency_mode"
            style="@style/ConverterModeChip"
            android:text="@string/currency_converter" />
    </com.google.android.material.chip.ChipGroup>
    <FrameLayout
        android:id="@+id/converter_placeholder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
