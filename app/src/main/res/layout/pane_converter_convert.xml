<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/convert_pane"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <net.smartlogic.unitconverter.widget.ConverterModeToggleGroup
        android:id="@+id/converter_mode_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/converter_card_margin"
        android:layout_marginTop="@dimen/converter_mode_margin_top"
        android:layout_marginBottom="@dimen/converter_mode_margin_bottom"
        app:selectionRequired="true" app:singleSelection="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_unit_mode"
            style="@style/ConverterModeSegment"
            android:text="@string/unit_converter" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_currency_mode"
            style="@style/ConverterModeSegment"
            android:text="@string/currency_converter" />
    </net.smartlogic.unitconverter.widget.ConverterModeToggleGroup>
    <FrameLayout
        android:id="@+id/converter_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
