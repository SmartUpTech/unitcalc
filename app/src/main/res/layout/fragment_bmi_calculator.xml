<net.smartlogic.unitconverter.bmi.BmiLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bmi_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/bmi_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="@dimen/converter_small_spacing">
                <TextView style="@style/BmiFieldLabel" android:text="@string/bmi_age" android:labelFor="@id/bmi_age_input" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <net.smartlogic.unitconverter.widget.AutoSizeEditText android:id="@+id/bmi_age_input" style="@style/BmiInput" android:inputType="number" android:contentDescription="@string/bmi_age_input" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/bmi_age_months" style="@style/BmiUnitButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/bmi_months_zero" android:contentDescription="@string/bmi_additional_months" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/converter_small_spacing">
                <TextView style="@style/BmiFieldLabel" android:text="@string/bmi_gender" android:labelFor="@id/bmi_gender_group" />
                <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/bmi_gender_group" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/bmi_gender_male" style="@style/BmiGenderIconButton" app:icon="@drawable/ic_bmi_gender_male" android:contentDescription="@string/bmi_gender_male" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/bmi_gender_female" style="@style/BmiGenderIconButton" app:icon="@drawable/ic_bmi_gender_female" android:contentDescription="@string/bmi_gender_female" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="@dimen/converter_small_spacing">
            <LinearLayout android:id="@+id/bmi_height_column" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="@dimen/converter_small_spacing">
                <TextView style="@style/BmiFieldLabel" android:text="@string/bmi_height" android:labelFor="@id/bmi_height_input" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <net.smartlogic.unitconverter.widget.AutoSizeEditText android:id="@+id/bmi_height_input" style="@style/BmiInput" android:contentDescription="@string/bmi_height_cm" />
                    <TextView android:id="@+id/bmi_feet_label" style="@style/BmiCaption" android:layout_width="wrap_content" android:text="@string/bmi_ft" android:visibility="gone" />
                    <net.smartlogic.unitconverter.widget.AutoSizeEditText android:id="@+id/bmi_inches_input" style="@style/BmiInput" android:contentDescription="@string/bmi_height_in" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/bmi_height_unit" style="@style/BmiUnitButton" android:layout_width="@dimen/converter_touch_target" android:layout_height="wrap_content" android:contentDescription="@string/bmi_height_unit" android:text="@string/bmi_cm" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/bmi_weight_column" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/converter_small_spacing">
                <TextView style="@style/BmiFieldLabel" android:text="@string/bmi_weight" android:labelFor="@id/bmi_weight_input" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <net.smartlogic.unitconverter.widget.AutoSizeEditText android:id="@+id/bmi_weight_input" style="@style/BmiInput" android:contentDescription="@string/bmi_weight_kg" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/bmi_weight_unit" style="@style/BmiUnitButton" android:layout_width="@dimen/converter_touch_target" android:layout_height="wrap_content" android:contentDescription="@string/bmi_weight_unit" android:text="@string/bmi_kg" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <net.smartlogic.unitconverter.bmi.BmiResultLayout android:id="@+id/bmi_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_converter_card" android:padding="@dimen/converter_spacing" android:tag="theme_outlined_surface" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:accessibilityLiveRegion="polite">
        <FrameLayout android:id="@+id/bmi_gauge_container" android:layout_width="match_parent" android:layout_height="wrap_content">
            <net.smartlogic.unitconverter.bmi.BmiGaugeView android:id="@+id/bmi_gauge" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
            <LinearLayout android:id="@+id/bmi_gauge_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:gravity="center" android:orientation="vertical" android:paddingBottom="@dimen/converter_compact_row_spacing">
                <TextView style="@style/BmiCaption" android:gravity="center" android:text="@string/bmi_label" />
                <TextView android:id="@+id/bmi_value" style="@style/BmiText" android:textSize="@dimen/bmi_value_size" android:gravity="center" android:text="@string/bmi_no_result" />
            </LinearLayout>
        </FrameLayout>
        <net.smartlogic.unitconverter.bmi.BmiSummaryLayout android:id="@+id/bmi_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite">
            <TextView android:id="@+id/bmi_category_value" style="@style/BmiText" android:textStyle="bold" android:gravity="center" android:text="@string/bmi_no_result" />
            <TextView android:id="@+id/bmi_difference_value" style="@style/BmiCaption" android:gravity="center" android:text="@string/bmi_no_result" />
            <TextView android:id="@+id/bmi_range_value" style="@style/BmiCaption" android:gravity="center" android:tag="content_primary" android:text="@string/bmi_no_result" />
            <TextView android:id="@+id/bmi_message" style="@style/BmiCaption" android:layout_width="match_parent" android:gravity="center" android:accessibilityLiveRegion="polite" />
        </net.smartlogic.unitconverter.bmi.BmiSummaryLayout>
            <TextView android:id="@+id/bmi_ranges" style="@style/BmiCaption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:importantForAccessibility="no" android:tag="content_accent" android:text="@string/bmi_ranges_short" />
    </net.smartlogic.unitconverter.bmi.BmiResultLayout>
    <androidx.fragment.app.FragmentContainerView android:id="@+id/bmi_keypad_host"
        android:name="net.smartlogic.unitconverter.bmi.BmiKeypadFragment"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</net.smartlogic.unitconverter.bmi.BmiLayout>
