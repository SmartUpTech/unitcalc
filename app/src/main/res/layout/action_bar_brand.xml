<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/btn_nav_menu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nav_open_drawer"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_menu" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald_bold"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="@string/app_bar_brand"
            android:textColor="@color/on_app_bar"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/oswald_regular"
            android:includeFontPadding="false"
            android:letterSpacing="0.18"
            android:text="@string/app_bar_product"
            android:textColor="@color/screen_expression_text"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
