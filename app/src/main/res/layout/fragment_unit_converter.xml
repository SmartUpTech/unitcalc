<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">
    <net.smartlogic.unitconverter.widget.CalculationViewport
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">
        <net.smartlogic.unitconverter.widget.CalculationLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/converter_spacing">
            <net.smartlogic.unitconverter.widget.ConverterControlsLayout
                android:id="@+id/calculation_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/category_selector"
                    style="@style/WorkspaceTabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/converter_touch_target"
                    android:layout_marginHorizontal="@dimen/converter_card_margin"
                    android:layout_marginTop="@dimen/converter_spacing"
                    android:layout_marginBottom="@dimen/converter_spacing"
                    app:tabMinWidth="@dimen/converter_category_min_width"
                    app:tabPaddingStart="@dimen/converter_spacing"
                    app:tabPaddingEnd="@dimen/converter_spacing"
                    app:tabTextAppearance="@style/ConverterCategoryText"
                    app:tabMode="scrollable"
                    app:tabGravity="start"
                    app:tabInlineLabel="false"
                    app:tabIndicatorHeight="@dimen/converter_category_indicator_height"
                    app:tabIconTint="@null" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/converter_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/converter_card_margin"
                    android:layout_marginEnd="@dimen/converter_swap_end_margin"
                    android:paddingVertical="@dimen/converter_spacing">
                    <net.smartlogic.unitconverter.widget.ConverterValueRow
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_0dp"
                        android:id="@+id/converter_source_section"
                        android:tag="calculation_section"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/reverse_container"
                        app:layout_constraintTop_toTopOf="parent"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/converter_row_height">
                        <net.smartlogic.unitconverter.widget.AutoSizeEditText
                            android:id="@+id/input"
                            android:tag="converter_amount"
                            android:paddingStart="@dimen/converter_spacing"
                            android:paddingEnd="@dimen/converter_spacing"
                            style="@style/ConverterValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/converter_input_amount" android:hint="@string/zero"
                            android:maxLength="12"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/converter_spacing"
                            android:gravity="right|center_vertical" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_weight="1.25">
                            <TextView
                                style="@style/ConverterLabel"
                                android:id="@+id/converter_from_label"
                                android:visibility="gone"
                                android:layout_width="@dimen/converter_label_width"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/converter_spacing"
                                android:labelFor="@id/fromUnit"
                                android:text="@string/str_from" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:tag="converter_selector"
                                android:paddingHorizontal="@dimen/converter_spacing"
                                android:foreground="?attr/selectableItemBackground"
                                android:id="@+id/from_selector"
                                android:clickable="true"
                                android:focusable="true">
                                <net.smartlogic.unitconverter.widget.ConverterPickerSpinner
                                    android:id="@+id/fromUnit"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:minHeight="@dimen/converter_touch_target"
                                    android:background="@null"
                                    android:dropDownWidth="match_parent"
                                    android:spinnerMode="dropdown" />
                                <ImageView
                                    android:id="@+id/fromChevron"
                                    android:layout_width="@dimen/converter_chevron_size"
                                    android:layout_height="@dimen/converter_chevron_size"
                                    android:src="@drawable/ic_chevron_down"
                                    android:importantForAccessibility="no"
                                    android:contentDescription="@null" />
                            </LinearLayout>
                        </LinearLayout>
                    </net.smartlogic.unitconverter.widget.ConverterValueRow>
                    <include
                        layout="@layout/converter_swap"
                        android:id="@+id/reverse_container"
                        android:layout_width="@dimen/converter_touch_target"
                        android:layout_height="@dimen/converter_touch_target"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                    <net.smartlogic.unitconverter.widget.ConverterValueRow
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_0dp"
                        android:id="@+id/converter_target_section"
                        android:layout_marginTop="@dimen/converter_small_spacing"
                        android:tag="calculation_section"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/reverse_container"
                        app:layout_constraintTop_toBottomOf="@id/converter_source_section"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/converter_row_height">
                        <net.smartlogic.unitconverter.widget.AutoSizeEditText
                            android:id="@+id/output"
                            android:tag="converter_amount"
                            android:paddingStart="@dimen/converter_spacing"
                            android:paddingEnd="@dimen/converter_spacing"
                            style="@style/ConverterValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/converter_output_amount"
                            android:focusable="false"
                            android:textIsSelectable="true"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/converter_spacing"
                            android:gravity="right|center_vertical" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_weight="1.25">
                            <TextView
                                style="@style/ConverterLabel"
                                android:id="@+id/converter_to_label"
                                android:visibility="gone"
                                android:layout_width="@dimen/converter_label_width"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/converter_spacing"
                                android:labelFor="@id/toUnit"
                                android:text="@string/str_to" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:tag="converter_selector"
                                android:paddingHorizontal="@dimen/converter_spacing"
                                android:foreground="?attr/selectableItemBackground"
                                android:id="@+id/to_selector"
                                android:clickable="true"
                                android:focusable="true">
                                <net.smartlogic.unitconverter.widget.ConverterPickerSpinner
                                    android:id="@+id/toUnit"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:minHeight="@dimen/converter_touch_target"
                                    android:background="@null"
                                    android:dropDownWidth="match_parent"
                                    android:spinnerMode="dropdown" />
                                <ImageView
                                    android:id="@+id/toChevron"
                                    android:layout_width="@dimen/converter_chevron_size"
                                    android:layout_height="@dimen/converter_chevron_size"
                                    android:src="@drawable/ic_chevron_down"
                                    android:importantForAccessibility="no"
                                    android:contentDescription="@null" />
                            </LinearLayout>
                        </LinearLayout>
                    </net.smartlogic.unitconverter.widget.ConverterValueRow>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:id="@+id/inputSymbol"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/outputSymbol"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/unit_rate"
                    style="@style/ConverterLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/converter_card_margin"
                    android:minHeight="@dimen/converter_metadata_height"
                    android:gravity="center_vertical"
                    android:textSize="@dimen/converter_unit_text_size" />
            </net.smartlogic.unitconverter.widget.ConverterControlsLayout>
            <include
                layout="@layout/converter_keypad"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:id="@+id/keypad" />
        </net.smartlogic.unitconverter.widget.CalculationLayout>
    </net.smartlogic.unitconverter.widget.CalculationViewport>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
