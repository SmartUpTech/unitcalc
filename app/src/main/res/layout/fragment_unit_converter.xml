<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calculator_accent_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".fragment.UnitConverterFragment">

        <net.smartlogic.unitconverter.helper.HorizontalListView
            android:id="@+id/horizontal_list"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="5dp" />

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:weightSum="9">

            <!-- From Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="@string/str_from"
                    android:textColor="@color/display_result_text_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spinnerHeight"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <EditText
                        android:id="@+id/input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_margin="2dp"
                        android:layout_weight="0.8"
                        android:background="@null"
                        android:gravity="center_vertical|end"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:maxLength="12"
                        android:padding="5dp"
                        android:textAlignment="textEnd"
                        android:textColor="@color/display_result_text_color"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/h2" />

                    <TextView
                        android:id="@+id/inputSymbol"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.2"
                        android:gravity="center_vertical|start"
                        android:padding="2dp"
                        android:textColor="@color/display_result_text_color"
                        android:textSize="@dimen/h3" />

                    <Spinner
                        android:id="@+id/fromUnit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/colorNewGrey" />
                </LinearLayout>

            </LinearLayout>

            <!-- To Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="@string/str_to"
                    android:textColor="@color/display_result_text_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spinnerHeight"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <EditText
                        android:id="@+id/output"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_margin="2dp"
                        android:layout_weight="0.8"
                        android:background="@null"
                        android:focusable="false"
                        android:gravity="center_vertical|end"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:padding="5dp"
                        android:textAlignment="textEnd"
                        android:textColor="@color/display_result_text_color"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/h2" />

                    <TextView
                        android:id="@+id/outputSymbol"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.2"
                        android:gravity="center_vertical|start"
                        android:padding="2dp"
                        android:textColor="@color/display_result_text_color"
                        android:textSize="@dimen/h3" />

                    <Spinner
                        android:id="@+id/toUnit"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/colorNewGrey" />
                </LinearLayout>

            </LinearLayout>

            <!-- Keypad Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="5"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="4">

                <TableLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:stretchColumns="*">

                    <TableRow
                        android:layout_height="0dp"
                        android:layout_weight="1">
                        <Button
                            android:id="@+id/seven"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/seven" />
                        <Button
                            android:id="@+id/eight"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/eight" />
                        <Button
                            android:id="@+id/nine"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/nine" />
                    </TableRow>

                    <TableRow
                        android:layout_height="0dp"
                        android:layout_weight="1">
                        <Button
                            android:id="@+id/four"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/four" />
                        <Button
                            android:id="@+id/five"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/five" />
                        <Button
                            android:id="@+id/six"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/six" />
                    </TableRow>

                    <TableRow
                        android:layout_height="0dp"
                        android:layout_weight="1">
                        <Button
                            android:id="@+id/one"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/one" />
                        <Button
                            android:id="@+id/two"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/two" />
                        <Button
                            android:id="@+id/three"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/three" />
                    </TableRow>

                    <TableRow
                        android:layout_height="0dp"
                        android:layout_weight="1">
                        <Button
                            android:id="@+id/zero"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/zero" />
                        <Button
                            android:id="@+id/double_zero"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/double_zero" />
                        <Button
                            android:id="@+id/dot"
                            style="@style/ButtonStyle.Number"
                            android:text="@string/dot" />
                    </TableRow>
                </TableLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:weightSum="4">

                    <ImageButton
                        android:id="@+id/reverse"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/pad_button_background"
                        android:contentDescription="Reverse"
                        android:src="@drawable/ic_reverse"
                        app:tint="@color/display_result_text_color" />

                    <ImageButton
                        android:id="@+id/backspace"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/pad_button_background"
                        android:contentDescription="Backspace"
                        android:src="@drawable/backspace"
                        app:tint="@color/display_result_text_color" />

                    <ImageButton
                        android:id="@+id/copy"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/pad_button_background"
                        android:contentDescription="Copy"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/display_result_text_color" />

                    <Button
                        android:id="@+id/minus"
                        style="@style/ButtonStyle.Number"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="@string/minus"
                        android:textColor="@color/colorHighlighter" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
