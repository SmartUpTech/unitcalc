<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/explore_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/oswald"
        android:letterSpacing="0.06"
        android:text="@string/nav_explore"
        android:textColor="@color/screen_result_text"
        android:textSize="22sp" />

    <EditText
        android:id="@+id/explore_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:fontFamily="@font/oswald"
        android:hint="@string/explore_search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:textColor="@color/screen_result_text"
        android:textColorHint="@color/screen_expression_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/explore_open_calculator"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/oswald"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:text="@string/tab_calculate"
        android:textColor="@color/screen_result_text"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/explore_open_converter"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/oswald"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:text="@string/tab_convert"
        android:textColor="@color/screen_result_text"
        android:textSize="18sp" />

</LinearLayout>
