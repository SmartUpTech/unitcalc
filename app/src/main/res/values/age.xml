    <string name="age_calendar_question">Birthday: %1$s. Add it once or repeat yearly? Review the date, repetition and reminders in your calendar app before saving.</string>
    <string name="age_calendar_once">Next birthday only</string>
    <string name="age_calendar_yearly">Repeat yearly</string>
    <string name="age_calendar_unavailable">No compatible calendar app is available.</string>
    <string name="age_share_unavailable">No app is available to share this result.</string>
