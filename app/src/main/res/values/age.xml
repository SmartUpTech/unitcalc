<resources>
    <!-- Two result sections need at least 200dp each before horizontal reflow. -->
    <dimen name="age_result_split_min_width">400dp</dimen>
    <dimen name="age_summary_value_size">20sp</dimen>
    <item name="age_calculator" type="id" />
























































    <style name="AgeText" parent="Widget.Graphy.TextView">
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/graphy_value_text_size</item>
        <item name="android:gravity">center</item>
        <item name="android:tag">content_primary</item>
    </style>
    <style name="AgeCaption" parent="AgeText">
        <item name="android:textSize">@dimen/graphy_label_text_size</item>
        <item name="android:tag">content_secondary</item>
    </style>
    <style name="AgeValue" parent="AgeText">
        <item name="android:textSize">@dimen/graphy_result_text_size</item>
        <item name="android:tag">content_accent</item>
    </style>
    <style name="AgeDateButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/app_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">@dimen/h3</item>
        <item name="android:minHeight">@dimen/converter_touch_target</item>
        <item name="android:minWidth">@dimen/converter_touch_target</item>
        <item name="android:insetTop">@dimen/spacing_0dp</item>
        <item name="android:insetBottom">@dimen/spacing_0dp</item>
        <item name="android:paddingLeft">@dimen/converter_spacing</item>
        <item name="android:paddingRight">@dimen/converter_spacing</item>
        <item name="cornerRadius">@dimen/graphy_node_corner_radius</item>
        <item name="android:tag">theme_outline_action</item>
    </style>
    <style name="AgeInlineDate" parent="AgeDateButton">
        <item name="android:tag">theme_outline_field</item>
        <item name="cornerRadius">@dimen/converter_selector_radius</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:textSize">@dimen/graphy_value_text_size</item>
        <item name="android:textStyle">normal</item>
        <item name="iconSize">@dimen/converter_chevron_size</item>
        <item name="iconPadding">@dimen/converter_small_spacing</item>
    </style>
</resources>
