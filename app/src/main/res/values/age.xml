    <string name="age_completed_years">Completed years</string>
    <string name="age_completed_months">Completed months</string>
    <string name="age_remaining_days">Remaining days</string>
    <string name="age_anniversary">Last anniversary</string>
    <string name="age_month_anchor">After completed months</string>
    <string name="age_year_step">%1$s → %2$s</string>
    <string name="age_month_step">%1$s → %2$s</string>
    <string name="age_day_step">%1$s → %2$s: %3$s</string>
    <string name="age_calendar_rule">Count completed years from the birth date, then completed months from that anniversary, then the remaining calendar days. February 29 anniversaries use February 28 in non-leap years. Month additions clamp to the last valid day of the target month.</string>
    <string name="age_share_body">Age Calculator\nDate of birth: %1$s\nAge as of: %2$s\nAge: %3$s\nNext birthday: %4$s (%5$s)\nCountdown: %6$s\n\nSummary\nYears: %7$s\nMonths: %8$s\nWeeks: %9$s\nDays: %10$s\nHours: %11$s\nMinutes: %12$s\nCompleted calendar units; hours and minutes use 24-hour days without time of birth.</string>
    <plurals name="age_years"><item quantity="one">%1$s year</item><item quantity="other">%1$s years</item></plurals>
    <plurals name="age_months"><item quantity="one">%1$s month</item><item quantity="other">%1$s months</item></plurals>
    <plurals name="age_days"><item quantity="one">%1$s day</item><item quantity="other">%1$s days</item></plurals>

    <style name="AgeText" parent="Widget.Graphy.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/h3</item>
        <item name="android:gravity">center</item>
        <item name="android:tag">content_primary</item>
    </style>
    <style name="AgeCaption" parent="AgeText">
        <item name="android:textSize">@dimen/h3_5</item>
        <item name="android:tag">content_secondary</item>
    </style>
    <style name="AgeValue" parent="AgeText">
        <item name="android:textSize">@dimen/h2</item>
        <item name="android:tag">content_accent</item>
    </style>
    <style name="AgeDateButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">@font/app_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/h3</item>
        <item name="android:minHeight">@dimen/converter_touch_target</item>
        <item name="android:minWidth">@dimen/converter_touch_target</item>
        <item name="android:insetTop">@dimen/spacing_0dp</item>
        <item name="android:insetBottom">@dimen/spacing_0dp</item>
        <item name="android:paddingLeft">@dimen/converter_spacing</item>
        <item name="android:paddingRight">@dimen/converter_spacing</item>
        <item name="cornerRadius">@dimen/graphy_node_corner_radius</item>
        <item name="android:tag">theme_outline_action</item>
    </style>
    <style name="AgeDatePickerTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:datePickerStyle">@style/AgeDatePicker</item>
        <item name="android:fontFamily">@font/app_text</item>
    </style>
    <style name="AgeDatePicker" parent="android:Widget.Material.DatePicker">
        <item name="android:datePickerMode">spinner</item>
        <item name="android:calendarViewShown">false</item>
    </style>
</resources>
