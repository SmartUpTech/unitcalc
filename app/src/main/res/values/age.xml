    <string name="age_invalid">Date of birth must be on or before Age as of.</string>
    <string name="age_totals_note">Completed calendar units. Hours and minutes use 24-hour days, without time of birth.</string>
    <string name="age_breakdown">%1$s, %2$s, %3$s</string>
    <string name="age_remaining">%1$s · %2$s</string>
    <string name="age_birthday_details">%1$s\n%2$s\n%3$s</string>
