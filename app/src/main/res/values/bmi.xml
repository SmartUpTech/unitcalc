<resources>
    <item type="id" name="bmi_reference_tabs" />
    <item type="id" name="bmi_reference_scroll" />




































    <item type="id" name="bmi_calculator" />







































































    <dimen name="bmi_gauge_min_height">72dp</dimen>
    <dimen name="bmi_gauge_tight_height">64dp</dimen>
    <dimen name="bmi_gauge_edit_height">56dp</dimen>
    <dimen name="bmi_gauge_height">120dp</dimen>
    <dimen name="bmi_gauge_stroke">10dp</dimen>
    <dimen name="bmi_value_size">28sp</dimen>
    <dimen name="bmi_label_width">64dp</dimen>
    <dimen name="bmi_unit_width">76dp</dimen>
    <dimen name="bmi_wide_width">560dp</dimen>
    <dimen name="bmi_controls_max_width">320dp</dimen>
    <dimen name="bmi_summary_columns_width">240dp</dimen>
    <dimen name="bmi_measurement_row_min_width">260dp</dimen>
    <dimen name="bmi_demographics_row_min_width">240dp</dimen>
    <dimen name="bmi_gender_icon_size">24dp</dimen>
    <dimen name="bmi_message_slot_height">40dp</dimen>
    <dimen name="bmi_keypad_row_height">48dp</dimen>
    <style name="BmiText" parent="Widget.Graphy.TextView">
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/graphy_value_text_size</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:tag">content_primary</item>
    </style>
    <style name="BmiCaption" parent="BmiText">
        <item name="android:textSize">@dimen/h3_5</item>
        <item name="android:tag">content_secondary</item>
    </style>
    <style name="BmiFieldLabel" parent="BmiCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginBottom">@dimen/converter_compact_row_spacing</item>
    </style>
    <style name="BmiUnitButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/app_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">@dimen/h3</item>
        <item name="android:minHeight">@dimen/converter_touch_target</item>
        <item name="android:minWidth">@dimen/converter_touch_target</item>
        <item name="android:insetTop">@dimen/spacing_0dp</item>
        <item name="android:insetBottom">@dimen/spacing_0dp</item>
        <item name="android:paddingLeft">@dimen/converter_spacing</item>
        <item name="android:paddingRight">@dimen/converter_spacing</item>
        <item name="cornerRadius">@dimen/graphy_node_corner_radius</item>
        <item name="android:tag">theme_outline_action</item>
    </style>
    <style name="BmiGenderIconButton" parent="BmiUnitButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/spacing_0dp</item>
        <item name="iconSize">@dimen/bmi_gender_icon_size</item>
        <item name="iconTintMode">src_in</item>
        <item name="android:gravity">center</item>
        <item name="android:text"></item>
        <item name="android:paddingLeft">@dimen/spacing_0dp</item>
        <item name="android:paddingRight">@dimen/spacing_0dp</item>
    </style>
    <style name="BmiInput" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">@dimen/converter_touch_target</item>
        <item name="android:minWidth">@dimen/converter_touch_target</item>
        <item name="android:textSize">@dimen/h2</item>
        <item name="android:fontFamily">@font/app_text</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">right|center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:paddingStart">@dimen/converter_spacing</item>
        <item name="android:paddingEnd">@dimen/converter_spacing</item>
        <item name="android:paddingTop">@dimen/spacing_0dp</item>
        <item name="android:paddingBottom">@dimen/spacing_0dp</item>
        <item name="android:layout_marginEnd">@dimen/converter_spacing</item>
        <item name="android:tag">converter_amount</item>
        <item name="android:saveEnabled">false</item>
    </style>
    <style name="BmiAgeInput" parent="BmiInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_weight">0</item>
        <item name="android:inputType">number</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:layout_marginEnd">@dimen/spacing_0dp</item>
    </style>
    <style name="BmiRangesCornerButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/app_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">@dimen/h3_5</item>
        <item name="android:minHeight">@dimen/converter_touch_target</item>
        <item name="android:minWidth">@dimen/converter_touch_target</item>
        <item name="android:insetTop">@dimen/spacing_0dp</item>
        <item name="android:insetBottom">@dimen/spacing_0dp</item>
        <item name="android:paddingLeft">@dimen/converter_small_spacing</item>
        <item name="android:paddingRight">@dimen/converter_small_spacing</item>
        <item name="android:layout_margin">@dimen/converter_compact_row_spacing</item>
        <item name="cornerRadius">@dimen/graphy_node_corner_radius</item>
        <item name="android:tag">theme_outline_action</item>
    </style>
</resources>
