<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/app_bar</item>
        <item name="colorPrimaryDark">@color/app_bar</item>
        <item name="colorAccent">@color/nav_selected</item>
        <item name="android:statusBarColor">@color/app_bar</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="actionBarStyle">@style/GraphyActionBar</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:actionBarWidgetTheme">@style/MyActionBarWidgetTheme</item>
    </style>

    <style name="GraphyActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/app_bar</item>
        <item name="titleTextStyle">@style/GraphyActionBarTitle</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="displayOptions">showCustom</item>
    </style>

    <style name="GraphyActionBarTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/on_app_bar</item>
        <item name="android:fontFamily">@font/oswald</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="MyActionBarWidgetTheme" parent="@android:style/Theme.Holo">
        <item name="android:textColorPrimary">@color/on_app_bar</item>
        <item name="android:textColorHint">@color/on_app_bar</item>
    </style>

    <style name="AppBaseTheme.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/app_bar</item>
        <item name="colorPrimaryDark">@color/app_bar</item>
        <item name="colorAccent">@color/nav_selected</item>
        <item name="popupTheme">@style/ThemeOverlay.MaterialComponents.Light</item>
    </style>

    <style name="WorkspaceTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:background">@color/screen_background</item>
        <item name="tabIndicatorColor">@color/accent</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabSelectedTextColor">@color/accent</item>
        <item name="tabTextColor">@color/screen_expression_text</item>
        <item name="tabRippleColor">@color/pad_button_ripple_color</item>
        <item name="tabUnboundedRipple">true</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
        <item name="tabTextAppearance">@style/WorkspaceTabText</item>
    </style>

    <style name="WorkspaceTabText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/oswald</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ConverterModeToggle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/oswald</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/converter_mode_text_color</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/converter_mode_stroke_color</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">@color/pad_button_ripple_color</item>
    </style>

    <style name="ConverterModeToggleGroup" parent="Widget.MaterialComponents.MaterialButtonToggleGroup">
        <item name="singleSelection">true</item>
        <item name="selectionRequired">true</item>
    </style>

    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="rippleColor">@color/pad_button_ripple_color</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:fontFamily">@font/oswald_regular</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textFontWeight" tools:targetApi="p">400</item>
        <item name="android:textSize">@dimen/buttonTextSize</item>
        <item name="android:textColor">@color/key_number_text</item>
    </style>

    <style name="ButtonStyle.Number">
        <item name="android:textColor">@color/key_number_text</item>
    </style>

    <style name="ButtonStyle.Operator">
        <item name="android:textColor">@color/key_operator_text</item>
    </style>

    <style name="ButtonStyle.Action">
        <item name="android:textColor">@color/key_action_text</item>
    </style>

    <style name="ButtonStyle.Equals">
        <item name="android:textColor">@color/key_equals_text</item>
        <item name="android:background">@drawable/bg_key_equals</item>
        <item name="backgroundTint">@null</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="ImageButtonStyle" parent="Widget.AppCompat.ImageButton">
        <item name="android:elevation">0dp</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="ImageButtonStyle.Swap" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_swap_key</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="tint">@color/accent</item>
        <item name="android:tint" tools:ignore="NewApi">@color/accent</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="ImageButtonStyle.Backspace" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_backspace_key</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="tint">@color/key_backspace_icon</item>
        <item name="android:tint" tools:ignore="NewApi">@color/key_backspace_icon</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="ImageButtonStyle.Action" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="tint">@color/key_action_text</item>
        <item name="android:tint" tools:ignore="NewApi">@color/key_action_text</item>
    </style>

    <style name="ActionButtons">
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/screen_result_text</item>
        <item name="android:textSize">@dimen/h4</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="ResultDisplay">
        <item name="android:fontFamily">@font/oswald</item>
        <item name="android:textColor">@color/screen_result_text</item>
        <item name="android:textSize">@dimen/resultDisplaySize</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.04</item>
    </style>

    <style name="RoundedCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/screen_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
